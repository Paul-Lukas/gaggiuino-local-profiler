package templates

import "fmt"

// ShotRow is the display-ready projection of a shots.Shot this package's
// templates render. It lives here (not in the parent internal/web package)
// so .templ files can reference its fields without an import cycle —
// internal/web imports internal/web/templates to call ShotsPage, so the
// type these templates render has to be defined on this side of that
// import. internal/web/view.go's toShotRow builds one from a hydrated
// shots.Shot plus its pre-computed score.
type ShotRow struct {
	ID           int64
	Time         string
	ProfileName  string
	Score        *int
	ScoreClass   string
	Coffee       string
	Dose         string
	Duration     string
	Rating       int
	GrindSetting string
	Grinder      string
}

// ShotsPage is the full GET /shots page: Phase 2a's (#901) first complete
// templ+htmx+Alpine template, modeled on public-src/components/sidebar.js's
// shot list (profile name, score, coffee/dose, star rating, grind badge,
// time — see go/internal/web/view.go's ShotRow doc comment) plus a trash
// section modeled on public-src/views/shots/index.js's renderTrash(). Not
// pixel-identical to the SPA (no chart, no annotation panel — this is a
// list page, not the shot-detail page), just functionally equivalent for
// the surface this first template package covers: view recent shots,
// trash one (with an Alpine confirm step), restore a trashed one, and
// filter the list client-side by profile/coffee text (Alpine x-show —
// see the dispatch brief's "htmx-Pagination oder Filter" choice point:
// filter was picked over pagination because internal/shots' Phase 1c
// repository methods have no LIMIT/OFFSET support to build real pagination
// on without changing that already-shipped package's contract).
templ ShotsPage(rows []ShotRow, trash []ShotRow) {
	@Layout("Shots") {
		<h1 class="page-title">Shots</h1>
		if len(rows) == 0 {
			<div class="empty-state">No shots yet.</div>
		} else {
			<div x-data="{ filterText: '' }">
				<input
					class="filter-input"
					type="text"
					placeholder="Filter by profile or coffee…"
					x-model="filterText"
					aria-label="Filter shots"
				/>
				<div class="shot-list" id="shot-list">
					for _, row := range rows {
						@shotRowActive(row)
					}
				</div>
			</div>
		}
		if len(trash) > 0 {
			<section class="trash-section">
				<h2 class="trash-heading">Trash ({ fmt.Sprintf("%d", len(trash)) })</h2>
				<div class="shot-list" id="trash-list">
					for _, row := range trash {
						@shotRowTrashed(row)
					}
				</div>
			</section>
		}
	}
}

// shotRowActive renders one row of the live (non-trashed) shot list, with
// an Alpine-driven confirm step (x-data/x-show/@click — no bespoke JS)
// gating the destructive htmx trash action, matching the dispatch brief's
// "Alpine.js-Beispiel für rein lokale UI-Interaktivität ... Modal-
// Bestätigung vor einer destruktiven Aktion" requirement directly.
templ shotRowActive(row ShotRow) {
	<div
		class="shot-row"
		id={ fmt.Sprintf("shot-row-%d", row.ID) }
		x-show="!filterText.length || $el.textContent.toLowerCase().includes(filterText.toLowerCase())"
	>
		@shotInfo(row)
		<div class="shot-actions" x-data="{ confirming: false }">
			<button type="button" class="btn btn-danger" x-show="!confirming" @click="confirming = true">
				Trash
			</button>
			<span class="confirm-bar" x-show="confirming" x-cloak>
				Delete this shot?
				<button
					type="button"
					class="btn btn-danger"
					hx-post={ fmt.Sprintf("shots/%d/trash", row.ID) }
					hx-target={ fmt.Sprintf("#shot-row-%d", row.ID) }
					hx-swap="outerHTML"
				>
					Yes
				</button>
				<button type="button" class="btn" @click="confirming = false">No</button>
			</span>
		</div>
	</div>
}

// shotRowTrashed renders one row of the trash section — no confirm step,
// since restoring isn't destructive.
templ shotRowTrashed(row ShotRow) {
	<div class="shot-row" id={ fmt.Sprintf("trash-row-%d", row.ID) }>
		@shotInfo(row)
		<div class="shot-actions">
			<button
				type="button"
				class="btn"
				hx-post={ fmt.Sprintf("shots/%d/restore", row.ID) }
				hx-target={ fmt.Sprintf("#trash-row-%d", row.ID) }
				hx-swap="outerHTML"
			>
				Restore
			</button>
		</div>
	</div>
}

// shotInfo is the read-only left-hand side both row variants share, laid
// out as a Verdict header (design pass 2, #901 — see
// public-src/style.css's .verdict-header/.verdict-line/.verdict-score-num
// and public-src/views/shots/index.js's renderVerdictHeader for the
// visual reference this ports; only the CSS-class structure and the
// typography-not-badge principle are carried over, not the Node advice-
// text computation, which needs shot-analysis logic this list page's
// ShotRow doesn't carry). .verdict-line: the score, at display size and
// colour-coded via the shared 3-tier scale (score-great/-ok/-bad), a
// plain "·" separator, then the headline — this page has no dial-in
// advice text to show, so the headline is the profile name, the one
// summarizing field ShotRow already carries. .verdict-subline: the same
// metadata the old .shot-meta line showed, muted, underneath. No card
// background, no border — flow text, same as the Node original's #816
// de-boxing.
templ shotInfo(row ShotRow) {
	<div class="shot-info">
		<div class="verdict-line">
			if row.Score != nil {
				<span class={ "verdict-score-num", row.ScoreClass }>{ fmt.Sprintf("%d", *row.Score) }</span>
				<span class="verdict-sep">·</span>
			}
			<span class="verdict-headline">{ row.ProfileName }</span>
		</div>
		<div class="verdict-subline">
			if row.Coffee != "" {
				{ row.Coffee }
			}
			if row.Dose != "" {
				{ " · " + row.Dose }
			}
			if row.GrindSetting != "" {
				{ " · grind " + row.GrindSetting }
			}
			if row.Rating > 0 {
				{ " · " + stars(row.Rating) }
			}
			{ " · " + row.Time }
		</div>
	</div>
}

// stars renders row.Rating as a plain "★★★☆☆"-style string — the
// text-only equivalent of sidebar.js's STAR_ICON_SVG.repeat(rating), kept
// as text rather than inline SVG to avoid this being the file that first
// needs to reckon with img-src/inline-SVG-under-CSP questions this
// foundation package doesn't need to answer yet.
func stars(rating int) string {
	if rating < 0 {
		rating = 0
	}
	if rating > 5 {
		rating = 5
	}
	filled := ""
	for i := 0; i < rating; i++ {
		filled += "★"
	}
	for i := rating; i < 5; i++ {
		filled += "☆"
	}
	return filled
}
