}

templ PuckScreensPage(rows []PuckScreenRow) {
	@Layout("Puck Screens") {
		<h1 class="page-title">Puck Screens</h1>
		if len(rows) == 0 {
			<div class="empty-state">No puck screens yet.</div>
		} else {
			<div class="item-list">
				for _, row := range rows {
					<div class="item-row">
						<div class="item-info">
							<div class="item-name">{ row.Name }</div>
							<div class="item-meta">
								if row.Thickness != "" {
									{ row.Thickness }
								}
								if row.Material != "" {
									{ " · " + row.Material }
								}
							</div>
						</div>
					</div>
				}
			</div>
		}
	}
}

// ── Milks ──────────────────────────────────────────────────────────────

// MilkRow is the display-ready projection of a library.Entity milk.
type MilkRow struct {
	ID      int64
	Name    string
	Emoji   string
	StockMl string // pre-formatted, e.g. "500 ml"
}

templ MilksPage(rows []MilkRow) {
	@Layout("Milks") {
		<h1 class="page-title">Milks</h1>
		if len(rows) == 0 {
			<div class="empty-state">No milks yet.</div>
		} else {
			<div class="item-list">
				for _, row := range rows {
					<div class="item-row">
						<div class="item-info">
							<div class="item-name">{ row.Emoji } { row.Name }</div>
							if row.StockMl != "" {
								<div class="item-meta">{ row.StockMl }</div>
							}
						</div>
					</div>
				}
			</div>
		}
	}
}

// ── Recipes ────────────────────────────────────────────────────────────

// RecipeRow is the display-ready projection of a library.Entity recipe.
type RecipeRow struct {
	ID         int64
	Name       string
	BrewMethod string
	DrinkType  string
}

templ RecipesPage(rows []RecipeRow) {
	@Layout("Recipes") {
		<h1 class="page-title">Recipes</h1>
		if len(rows) == 0 {
			<div class="empty-state">No recipes yet.</div>
		} else {
			<div class="item-list">
				for _, row := range rows {
					<div class="item-row">
						<div class="item-info">
							<div class="item-name">{ row.Name }</div>
							<div class="item-meta">
								{ row.BrewMethod }
								if row.DrinkType != "" {
									{ " · " + row.DrinkType }
								}
							</div>
						</div>
					</div>
				}
			</div>
		}
	}
}
